<%- include('partials/header') %>

<div class="auth-wrap">
  <hgroup>
    <h2>账号设置</h2>
    <p class="muted">当前身份：<%= me.nickname %>（<%= me.user_id %>）<%- include('partials/eye', { uid: me.user_id }) %></p>
  </hgroup>

  <% if (error) { %><div class="flash flash-err"><%= error %></div><% } %>

  <%# 游戏名（2026-10-17 加）：Windows 端的 OCR 认出来的是**游戏里显示的名字**，
      积分录入接口按它找本站用户（见 routes/api.js）。填了才能被自动录分。 %>
  <h3>游戏名</h3>
  <p class="muted small">
    填你在<strong>游戏里显示的名字</strong>（不是本站昵称）。填了之后，积分识别程序
    才能把分数自动记到你头上；同一个游戏名只能被一个人占用，留空就是清除。
  </p>
  <form method="post" action="/password/game-name">
    <label>游戏名
      <input type="text" name="game_name" maxlength="32" autocomplete="off"
             value="<%= me.game_name || '' %>" placeholder="游戏里显示的名字">
    </label>
    <button type="submit" class="fit">保存游戏名</button>
  </form>

  <h3>改密码</h3>
  <form method="post" action="/password">
    <label>当前密码
      <input type="password" name="old" required autocomplete="current-password">
    </label>
    <label>新密码
      <input type="password" name="next" required autocomplete="new-password" placeholder="至少 6 位">
    </label>
    <label>确认新密码
      <input type="password" name="next2" required autocomplete="new-password">
    </label>
    <button type="submit" class="fit">保存</button>
  </form>
</div>

<%- include('partials/footer') %>
