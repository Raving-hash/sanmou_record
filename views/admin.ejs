<%- include('partials/header') %>

<hgroup class="page-head">
  <h2>管理</h2>
  <p class="muted">邀请码、赛期、成员</p>
</hgroup>

<section class="card">
  <h3>邀请码</h3>
  <% if (invite) { %>
    <p>当前邀请码：<code class="invite-code" id="inviteCode"><%= invite %></code></p>
    <label>注册链接
      <span class="copy-row">
        <input id="inviteLink" readonly value="<%= origin %>/register?code=<%= invite %>">
        <button type="button" class="secondary btn-sm" data-copy="inviteLink">复制</button>
      </span>
    </label>
    <p class="muted small">这个码可以无限次使用，拿到的人都能注册。朋友们注册完建议点【关闭注册】，以后有新人再加入时再打开。</p>
  <% } else { %>
    <p><span class="badge badge-wait">注册已关闭</span> 现在任何邀请码都用不了。</p>
  <% } %>

  <div class="actions">
    <form method="post" action="/admin/invite/regenerate"
          data-confirm="重新生成后旧邀请码立刻失效，确定吗？">
      <button type="submit">重新生成邀请码</button>
    </form>
    <% if (invite) { %>
      <form method="post" action="/admin/invite/close">
        <button type="submit" class="outline secondary">关闭注册</button>
      </form>
    <% } %>
  </div>
</section>

<section class="card">
  <h3>赛期</h3>
  <% if (openSeason) { %>
    <p class="muted small">
      当前进行中：<strong><%= openSeason.name %></strong>。同一时间只能有一期进行中。
      <%# 打分截止是按开期时间算出来的（每期开期后第一个周四 12:00），管理员要靠它决定何时结算 %>
      · 打分<% if (canRate) { %>截止 <strong><%= fmt(rateLockAt) %></strong>（<%= fmtLeft(rateLockAt - Date.now()) %>）<% } else { %>已于 <strong><%= fmt(rateLockAt) %></strong> 截止，可以结算了<% } %>
    </p>
  <% } %>
  <form method="post" action="/admin/seasons" class="inline-create">
    <label>新建赛期
      <input name="name" required maxlength="40" placeholder="例如 第32期" <%= openSeason ? 'disabled' : '' %>>
    </label>
    <button type="submit" <%= openSeason ? 'disabled' : '' %>>创建</button>
  </form>
  <% if (!openSeason) { %>
    <%# 截止点是**按开期时间**算的，所以开期时间一变，窗口长短就变（周三开只有一天多）。
        先摆出来，省得开完才发现这期几乎没法投 %>
    <p class="muted small">
      注意：打分的截止点是按<strong>开期时间</strong>算的 —— 每期开期后遇到的第一个周四 12:00（北京）就封盘。
      现在开一期的话，打分截止在 <strong><%= fmt(nextLockAt) %></strong>（<%= fmtLeft(nextLockAt - Date.now()) %>）。
    </p>
  <% } %>

  <% if (!seasons.length) { %>
    <p class="muted">还没有任何一期。</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>期名</th>
            <th class="w-time">日期</th>
            <th class="w-status">状态</th>
            <th>胜者</th>
            <th class="w-players">参赛</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% seasons.forEach((s) => { %>
            <tr>
              <td><a href="/seasons/<%= s.id %>"><%= s.name %></a></td>
              <td><small class="muted"><%= fmt(s.created_at) %></small></td>
              <td>
                <% if (s.status === 'open') { %>
                  <span class="badge badge-open">进行中</span>
                <% } else { %>
                  <span class="badge badge-settled">已结算</span>
                <% } %>
              </td>
              <%# 胜者可能有两位（每期积分前两名都算赢，见 db.js 的 TOP_N），
                  所以这列是**列表**：每人「昵称（积分）」+ 各自的慧眼圆框，用顿号隔开。 %>
              <td><%= s.winners.length ? s.winners.map((w) => `${w.nickname}（${w.score}）`).join('、') : '—' %><% s.winners.forEach((w) => { %><%- include('partials/eye', { uid: w.uid }) %><% }) %></td>
              <td class="num"><%= s.players %></td>
              <td class="row-actions">
                <% if (s.status === 'open') { %>
                  <form method="post" action="/admin/seasons/<%= s.id %>/settle"
                        data-confirm="结束本期并结算？要至少 2 人交了积分。">
                    <button type="submit" class="btn-sm">结束本期</button>
                  </form>
                <% } else { %>
                  <form method="post" action="/admin/seasons/<%= s.id %>/reopen"
                        data-confirm="撤销结算？这一期会变回进行中。">
                    <button type="submit" class="outline secondary btn-sm">撤销结算</button>
                  </form>
                <% } %>
                <form method="post" action="/admin/seasons/<%= s.id %>/delete"
                      data-confirm="删除这一期？连同所有积分和阵容截图一起删掉，不能恢复。">
                  <button type="submit" class="outline btn-danger btn-sm">删除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%# 本人的票在截止前（每期开期后第一个周四 12:00）能自己改，所以这儿不是唯一的出口：
    它管的是"过了截止要撤掉某条票"和"本人投错了、要重置成没打过"。
    默认收起，免得几十行打分把管理页撑长。 %>
<section class="card">
  <h3>打分记录</h3>
  <% if (!openSeason) { %>
    <p class="muted small">现在没有进行中的赛期。打分只能在进行中的期产生，要清历史期的记录，
      先在上面把那一期【撤销结算】。</p>
  <% } else { %>
    <details>
      <summary>本期（<%= openSeason.name %>）共 <%= seasonRatings.length %> 条打分</summary>
      <% if (!seasonRatings.length) { %>
        <p class="muted">这一期还没有人打分。</p>
      <% } else { %>
        <p class="muted small">
          删掉之后那个人对这套阵容重新变成「没打过」<%= canRate ? '，可以再打一次' : '；本期打分已截止，删掉就补不回来了' %>。
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>打给谁</th>
                <th>打分人</th>
                <th class="w-score">分数</th>
                <th class="w-time">时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% seasonRatings.forEach((r) => { %>
                <tr>
                  <td><a href="/u/<%= r.target_uid %>"><%= r.target_name %></a>
                    <%- include('partials/eye', { uid: r.target_uid }) %></td>
                  <td><a href="/u/<%= r.rater_uid %>"><%= r.rater_name %></a>
                    <%- include('partials/eye', { uid: r.rater_uid }) %></td>
                  <td class="num"><strong><%= r.value %></strong></td>
                  <td><small class="muted"><%= fmt(r.created_at) %></small></td>
                  <td class="row-actions">
                    <form method="post" action="/admin/ratings/<%= r.id %>/delete"
                          data-confirm="清掉 <%= r.rater_name %> 给 <%= r.target_name %> 打的 <%= r.value %> 分？删掉就没了。">
                      <button type="submit" class="outline btn-danger btn-sm">清除</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%# 整批清空。摆在表格**下面**而不是标题旁边：它是这一页唯一不可逆的批量操作，
            贴着几十个逐条【清除】按钮容易被手滑点到；顺带让人先把名单扫过一遍。 %>
        <div class="actions">
          <form method="post" action="/admin/seasons/<%= openSeason.id %>/ratings/clear"
                data-confirm="清空本期全部 <%= seasonRatings.length %> 条打分？<%= canRate ? '清掉之后大家都可以重新投（名额也一起回来）。' : '本期打分已截止，清掉就再也补不回来了。' %>">
            <button type="submit" class="outline btn-danger btn-sm">
              清空本期全部打分（<%= seasonRatings.length %> 条）
            </button>
          </form>
        </div>
        <p class="muted small">
          整期重投用这个：清完所有人的名额会一并满血（名额是现数的，见 README「每期名额」一节）。
          <%= canRate ? '本期还没截止，清掉之后大家都能重新投。' : '⚠️ 本期打分已截止，清掉之后谁都不能重投。' %>
        </p>
      <% } %>
    </details>
  <% } %>
</section>

<section class="card">
  <%# 阵容识别的效果（2026-10-16 加）。用户要的"整理反思"落点：
      看机器猜得准不准、玩家是不是点一下就够了、手输了哪些库里没有的名字。 %>
  <h3>阵容识别</h3>
  <% if (!recoEnabled) { %>
    <p class="muted small">herodata/ 不在，识别未启用。卡面素材是游戏版权图、不进仓库，
      线上要手工放一份（同 deploy/ 和 .env）。</p>
  <% } %>
  <div class="table-wrap">
    <table>
      <tbody>
        <tr><th>识别过的格子</th><td class="num"><%= reco.total %></td>
            <td class="muted small">一张阵容图 9 格，会随上传自动跑</td></tr>
        <tr><th>玩家确认过的</th><td class="num"><%= reco.decided %></td>
            <td class="muted small">点候选 <%= reco.pick %> · 手输 <%= reco.other %> · 点「不确定」<%= reco.none %></td></tr>
        <%# 下面三行的分母是**选出了武将的那些格子**（top3 + notInCand），不是全部格子 ——
            玩家点「不确定」的不该算机器认错。top1 ⊂ top3。
            top1 决定"能不能做全自动"（现在还不够），top3 决定"点一下够不够"。 %>
        <% const picked = reco.top3 + reco.notInCand;
           const pct = (n) => (picked ? `（${Math.round(n * 100 / picked)}%）` : ''); %>
        <tr><th>机器头名就是对的</th>
            <td class="num"><%= reco.top1 %><% if (picked) { %> <span class="muted small">/ <%= picked %></span><% } %></td>
            <td class="muted small">决定能不能做全自动 —— 现在还不够<%= pct(reco.top1) %></td></tr>
        <tr><th>答案在给的三个候选里</th>
            <td class="num"><%= reco.top3 %><% if (picked) { %> <span class="muted small">/ <%= picked %></span><% } %></td>
            <td class="muted small">**这个数才是交互成不成立的依据**：在的话玩家点一下就行<%= pct(reco.top3) %></td></tr>
        <tr><th>选的武将不在候选里</th><td class="num"><%= reco.notInCand %></td>
            <td class="muted small">多半是从「其他」手输的，说明那格机器没推对</td></tr>
      </tbody>
    </table>
  </div>
  <% if (reco.unresolved.length) { %>
    <p class="muted small">玩家手输了、但库里对不上的名字（<%= reco.unresolved.length %> 个）——
      要么库里漏了武将，要么他打错了字：</p>
    <p class="small"><%= [...new Set(reco.unresolved)].join('、') %></p>
  <% } %>

  <h3>成员（<%= users.length %>）</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>昵称</th>
          <th>ID</th>
          <th class="w-status">状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr class="<%= u.is_disabled ? 'row-muted' : '' %>">
            <td><a href="/u/<%= u.user_id %>"><%= u.nickname %></a>
              <%- include('partials/eye', { uid: u.user_id }) %>
              <% if (u.is_admin) { %><span class="badge badge-admin">管理员</span><% } %>
            </td>
            <td><code><%= u.user_id %></code></td>
            <td>
              <% if (u.is_disabled) { %>
                <span class="badge badge-wait">已禁用</span>
              <% } else { %>
                <span class="badge badge-ok">正常</span>
              <% } %>
            </td>
            <td class="row-actions">
              <% if (u.id !== me.id) { %>
                <form method="post" action="/admin/users/<%= u.id %>/toggle">
                  <button type="submit" class="outline secondary btn-sm">
                    <%= u.is_disabled ? '启用' : '禁用' %>
                  </button>
                </form>
              <% } %>
              <form method="post" action="/admin/users/<%= u.id %>/reset"
                    data-confirm="重置 <%= u.nickname %> 的密码？会生成一个临时密码。">
                <button type="submit" class="outline secondary btn-sm">重置密码</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<script>
  // 确认框统一走 data-confirm，**不要**写回 onsubmit="return confirm('…把昵称拼进来…')"：
  // 昵称是成员自己起的（1–12 个字，什么字符都行），转义把 ' 变成 &#39; 之后，
  // 浏览器解析属性时又会还原成 '，于是那个引号能从 JS 字符串里跑出来执行。
  // data-confirm 里的东西只是**数据**（dataset 读出来就是纯字符串），没有这个问题。
  // 没有 JS 时这里不弹确认框，表单照旧提交 —— 和原先的 onsubmit 行为一样。
  // （这段注释里不能出现 EJS 的开始标记：模板里**任何位置**的标记都会被求值，注释也一样。）
  document.querySelectorAll('form[data-confirm]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      if (!confirm(form.dataset.confirm)) e.preventDefault();
    });
  });

  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var el = document.getElementById(btn.dataset.copy);
      if (!el) return;
      var text = el.value || el.textContent;
      var done = function () {
        var old = btn.textContent;
        btn.textContent = '已复制';
        setTimeout(function () { btn.textContent = old; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { el.select(); document.execCommand('copy'); done(); });
      } else {
        el.select();
        document.execCommand('copy');
        done();
      }
    });
  });
</script>

<%- include('partials/footer') %>
