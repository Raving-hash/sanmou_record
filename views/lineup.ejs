<%- include('partials/header') %>

<hgroup class="page-head">
  <h2><%= acting ? `替 ${targetUser.nickname} 上传阵容` : '上传阵容' %> · <%= season.name %></h2>
  <% if (acting) { %>
    <p class="muted">你正在以管理员身份替
      <strong><%= targetUser.nickname %></strong>（<%= targetUser.user_id %>）操作。</p>
  <% } else { %>
    <p class="muted">每期一张，支持 jpg / png / webp，在浏览器里压缩后上传</p>
  <% } %>
</hgroup>

<%# 上传窗口（2026-10-18 改口径，见 db.getUploadPhase）：
     · 周二 12:00 之前 —— 关着；
     · 周二 12:00–周三 12:00 —— 初步阵容窗口：传的图**只作展示**，不识别、不进数据；
     · 周三 12:00 之后 —— 完整阵容窗口：传的完整图会**覆盖**掉那张初步图。
     页面不出组件不等于没人能传，**拦人的是服务端那一道**（POST /lineup）。
     已传的图仍然列在下面、仍然能删：窗口一关连传错的都撤不掉，那才叫坑。
     2026-10-22：管理员不受窗口限制（adminOverride）—— 窗口关着时按完整图入库。 %>
<% if (adminOverride) { %>
  <p class="flash flash-ok">
    管理员上传：现在<strong>不在阵容上传窗口内</strong>，这张图按
    <strong>完整阵容图</strong>入库（会进识别、计入武将统计）。
  </p>
<% } else if (uploadClosed) { %>
  <p class="flash flash-err">阵容要到 <strong><%= fmt(uploadOpenAt) %></strong> 才开放上传。
    现在还不能传新的。</p>
<% } else if (uploadPhase === 'preliminary') { %>
  <p class="flash flash-ok">
    现在是<strong>初步阵容</strong>窗口（到 <strong><%= fmt(fullUploadAt) %></strong> 为止）：
    这张图只作展示，<strong>不做识别、不计入武将数据</strong>，也不算参赛。
    这期间大家已经可以打分了；<strong><%= fmt(fullUploadAt) %></strong> 之后传完整阵容图
    会自动覆盖它。
  </p>
<% } else { %>
  <p class="flash flash-ok">
    <strong>完整阵容</strong>窗口已开放：现在传的图会进识别、计入武将统计。
    <% if (images.some((i) => i.is_preliminary)) { %>
      这次上传会<strong>覆盖</strong>下面那张初步阵容图。
    <% } %>
  </p>
<% } %>

<h3>已上传（<%= images.length %> / <%= max %>）</h3>
<% if (!images.length) { %>
  <p class="muted">还没传阵容截图。传了之后所有登录的成员都能看到。</p>
<% } else { %>
  <div class="gallery">
    <% images.forEach((img) => { %>
      <figure>
        <a href="<%= imgUrl(img.filename) %>" target="_blank" rel="noopener">
          <img src="<%= thumbUrl(img.filename) %>" alt="阵容截图" loading="lazy">
        </a>
        <% if (img.is_preliminary) { %>
          <p><span class="badge badge-wait"
                   title="初步阵容：只作展示，不做识别、不计入武将数据，也不算参赛；周三 12:00 后会被完整阵容图覆盖">初步阵容</span></p>
        <% } else { %>
          <p><span class="badge badge-ok">完整阵容</span></p>
        <% } %>
        <form method="post" action="/lineup/<%= img.id %>/delete">
          <button type="submit" class="outline secondary btn-sm">删除</button>
        </form>
      </figure>
    <% }) %>
  </div>
<% } %>

<%# ⚠ 这个表单**不能有 enctype="multipart/form-data"**：字节是由浏览器直传 R2 的，
     表单本身只剩 lineup_note 一个文字字段。留着 enctype 的话浏览器按 multipart 发，
     而服务端已经没有 multer（没有任何 multipart 解析器），lineup_note 会**静默丢失**
     —— 表现是"说明保存不上"，特别难查。
     ⚠ 文件 input **不能有 name**：没有名字它才不参与提交。这是"字节不再经手服务端"的
     结构性保证，不是靠 input.value='' 之类的技巧。同一条也见 views/score.ejs。 %>
<% if (!uploadClosed) { %>
<%# 文件框什么时候出：
     · 初步窗口 —— 和从前一样，没图才出（换图先删）；
     · 完整窗口 —— **没有完整图**就出。只有初步图时正是"覆盖"的入口，不能藏掉。 %>
<% const canUpload = uploadPhase === 'preliminary' ? images.length < max : !hasFullImage; %>
<form method="post" action="/lineup"
      data-upload-kind="lineup" data-key-field="images"
      data-upload-max-bytes="<%= maxOutBytes %>">
  <%# 代操作（2026-10-22）：POST 用它决定写进谁的 entry；upload.js 也读它，
      喂给 /uploads/sign 做**目标成员**的额度预检。 %>
  <% if (acting) { %><input type="hidden" name="user" value="<%= targetUser.user_id %>"><% } %>
  <%# 每期只允许一张，所以传满了就不再出文件框（只剩"说明"还能改）。
       `multiple` 去掉、`data-max` 也就没意义了 —— 留着会让人以为还能多选。 %>
  <% if (canUpload) { %>
    <label><%= uploadPhase === 'preliminary' ? '上传初步阵容图' : '上传完整阵容图' %>
      <input type="file" accept="image/jpeg,image/png,image/webp"
             data-max="<%= max - (uploadPhase === 'preliminary' ? images.length : 0) %>">
      <small class="muted">
        <% if (uploadPhase === 'preliminary') { %>
          每期只能用一张，想换的话先把上面那张删掉
        <% } else if (images.some((i) => i.is_preliminary)) { %>
          这次上传会覆盖上面那张初步阵容图
        <% } else { %>
          每期只能用一张，想换的话先把上面那张删掉
        <% } %>
      </small>
    </label>
  <% } %>
  <label>阵容说明
    <textarea name="lineup_note" rows="3"
              placeholder="这套阵容的思路、站位、克制谁……"><%= entry && entry.lineup_note ? entry.lineup_note : '' %></textarea>
  </label>
  <button type="submit">保存</button>
  <%# 图片由浏览器直传图床，**这一步必须有 JS**（服务端不再收字节了）。
      从前"脚本没加载也照旧"那条降级没有了，所以明说一句，别让人对着一个
      点了没反应的按钮猜。 %>
  <noscript><p class="flash flash-err">你的浏览器禁用了 JavaScript，传不了图。
    请换个浏览器、或者把本站的 JS 放开——这是把图片直传图床所必需的。</p></noscript>
</form>
<% } %>

<p><small class="muted">只改阵容截图或说明，不会影响<%= acting ? '该成员' : '你' %>的积分提交时间。</small></p>

<%# 拖拽上传。挂在表单后面：脚本执行时 input 已经在 DOM 里，不用等 DOMContentLoaded。
     ?v= 和样式表同理 —— nginx 给 /public/ 盖了 max-age=604800。 %>
<script src="/public/upload.js?v=<%= assetVer.upload %>"></script>

<%- include('partials/footer') %>
