<%- include('partials/header') %>

<hgroup class="page-head">
  <h2><%= u.nickname %><%- include('partials/eye', { uid: u.user_id }) %><% if (u.is_disabled) { %> <span class="badge badge-wait">已禁用</span><% } %></h2>
  <p class="muted">ID：<%= u.user_id %> · 加入于 <%= fmt(u.created_at) %></p>
</hgroup>

<% if (!stats) { %>
  <p class="muted">还没有已结算的战绩。</p>
<% } else { %>
  <div class="stat-grid">
    <article class="stat"><span class="stat-num"><%= stats.wins %></span><span class="stat-label">胜场</span></article>
    <article class="stat"><span class="stat-num"><%= stats.plays %></span><span class="stat-label">参赛</span></article>
    <article class="stat"><span class="stat-num"><%= stats.win_rate %>%</span><span class="stat-label">胜率</span></article>
    <%# 平均分 / 最高分只算交过积分的期：只传阵容没录分的人这两格是空的，印「—」不留白 %>
    <article class="stat"><span class="stat-num"><%= stats.avg_score ?? '—' %></span><span class="stat-label">平均分</span></article>
    <article class="stat"><span class="stat-num"><%= stats.best_score ?? '—' %></span><span class="stat-label">最高分</span></article>
    <article class="stat"><span class="stat-num"><%= stats.best_rank ?? '—' %></span><span class="stat-label">最佳名次</span></article>
  </div>
<% } %>

<% if (recent && recent.length) { %>
  <h3>近期状态</h3>
  <p class="form-line">
    <% recent.slice().reverse().forEach((r) => { %>
      <span class="form-chip<%= r.is_winner === 1 ? ' is-win' : (!r.participated ? ' is-absent' : (r.score === null ? ' is-noscore' : ' is-loss')) %>"
            title="<%= r.name %><% if (!r.participated) { %> · 未参赛<% } else if (r.score === null) { %> · 未交积分<% } else if (r.is_winner === 1) { %> · 获胜<% } else { %> · 第 <%= r.final_rank %> 名<% } %>"><% if (r.is_winner === 1) { %>胜<% } else if (!r.participated) { %>缺<% } else if (r.score === null) { %>未交<% } else { %>负<% } %></span>
    <% }) %>
    <% if (streak > 0) { %><span class="muted small">当前 <strong><%= streak %></strong> 连胜</span><% } %>
    <% if (scoreDelta !== null) { %><span class="muted small">较上次交分
      <strong class="<%= scoreDelta > 0 ? 'delta-up' : scoreDelta < 0 ? 'delta-down' : '' %>"><%= scoreDelta > 0 ? '+' : '' %><%= scoreDelta %></strong></span><% } %>
  </p>
<% } %>

<% if (commonHeroes && commonHeroes.length) { %>
  <h3>常用武将</h3>
  <p class="hero-chip-row">
    <% commonHeroes.forEach((h) => { %>
      <a class="hero-chip" href="/hero/<%= h.key %>"><%= (h.variant || '') + h.name %> <small><%= h.n %></small></a>
    <% }) %>
  </p>
<% } %>

<h3>历史各期</h3>
<% if (!history.length) { %>
  <p class="muted">还没有参加过的已结算赛期。</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>期名</th>
          <th class="w-time">日期</th>
          <th class="w-score">积分</th>
          <th class="w-rank">名次</th>
          <th>结果</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach((h) => { %>
          <%# 2026-10-15 起这张表列的是**参过的每一期**（从前只列交了积分的期）：
              传了阵容就算参赛、就占了胜率的分母，所以"参赛未交分"也是一种结果。
              那种行没有积分也没有名次，两格印「—」，结果写清楚是没交分。 %>
          <tr class="<%= h.is_winner ? 'row-first' : '' %>">
            <td><a href="/seasons/<%= h.id %>"><%= h.name %></a></td>
            <td><small class="muted"><%= fmt(h.created_at) %></small></td>
            <td class="num"><%= h.score === null ? '—' : h.score %></td>
            <td class="num"><%= h.final_rank === null ? '—' : h.final_rank %></td>
            <td>
              <% if (h.is_winner) { %>
                <span class="badge badge-first">👑 获胜</span>
              <% } else if (h.score === null) { %>
                <small class="muted">未交积分</small>
              <% } else { %>
                <small class="muted">第 <%= h.final_rank %> 名 / 共 <%= h.players %> 人</small>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<h3>阵容档案</h3>
<% if (!archive || !archive.length) { %>
  <p class="muted">还没有上传过阵容。</p>
<% } else { %>
  <div class="archive-list">
    <% archive.forEach((r) => { const tier = lineupTier(r.heroes); %>
      <article class="archive-card">
        <div class="archive-shot">
          <% if (r.images[0]) { const shots = r.images.map((i) => imgUrl(i.filename)).join(' '); %>
            <a href="<%= imgUrl(r.images[0].filename) %>" target="_blank" rel="noopener"
               data-shots="<%= shots %>">
              <img src="<%= thumbUrl(r.images[0].filename) %>"
                   alt="<%= r.nickname %> 的阵容截图" loading="lazy">
            </a>
          <% } %>
        </div>
        <div class="archive-body">
          <p class="archive-head">
            <a class="muted" href="/seasons/<%= r.season_id %>/wall#e<%= r.id %>"><%= r.season_name %><% if (r.season_status === 'open') { %> · 进行中<% } %></a>
            <span class="score-pill"><% if (r.score === null) { %>未交分<% } else { %><%= r.score %> 分<% } %></span>
            <% if (r.season_status === 'settled') { %>
              <% if (r.is_winner) { %><span class="badge badge-first">👑 胜者</span>
              <% } else if (r.final_rank) { %><small class="muted">第 <%= r.final_rank %> 名</small><% } %>
            <% } else { %><span class="badge badge-open">进行中</span><% } %>
          </p>
          <p class="archive-meta">
            <span class="reco-tier is-<%= tier.tier.toLowerCase() %>"><%= tier.tier %></span>
            <% r.heroes.filter((h) => isT0(h.key)).forEach((h) => { %>
              <span class="hero-chip<% if (h.auto) { %> is-auto<% } %>"><%= (h.variant || '') + h.name %><% if (h.auto) { %> ?<% } %></span>
            <% }) %>
            <% if (r.rating.avg !== null) { %><span class="muted small">互评 <%= r.rating.avg %>（<%= r.rating.n %>）</span><% } %>
            <% if (commentsEnabled && r.commentsN) { %><span class="muted small">💬 <%= r.commentsN %></span><% } %>
          </p>
          <% if (r.lineup_note) { %><p class="archive-note"><%= r.lineup_note %></p><% } %>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
