<%- include('partials/header') %>

<% if (season) { %>

  <hgroup class="page-head">
    <h2><%= season.name %> <span class="badge badge-open">进行中</span></h2>
    <p class="muted">开始于 <%= fmt(season.created_at) %> · 积分前两名都算胜者，同分时先提交的排前面</p>
  </hgroup>

  <div class="actions">
    <a role="button" href="/lineup">上传阵容</a>
    <a role="button" class="secondary" href="/score">录入积分</a>
  </div>

  <% if (me_entry && me_entry.score !== null) { %>
    <article class="mine-card">
      <p>你本期已提交 <strong class="num"><%= me_entry.score %></strong> 分
        <small class="muted">（提交于 <%= fmt(me_entry.score_submitted_at) %>）</small></p>
      <p class="muted small">改分或换截图会刷新提交时间，同分时排名会靠后。</p>
    </article>
  <% } else if (me_entry) { %>
    <article class="mine-card">
      <p class="muted">你本期传了阵容但还没录积分 —— <a href="/score">现在录入</a>。
        传了阵容就算参赛（占着参赛次数和胜率的分母），但<strong>没有积分就没有名次</strong>：
        每期的胜者是积分前两名。</p>
    </article>
  <% } else { %>
    <article class="mine-card">
      <p class="muted">你本期还没开始 —— <a href="/lineup">上传阵容</a>、<a href="/score">录入积分</a>。</p>
    </article>
  <% } %>

  <%# 进行中的期**不出「本期排名」那一节**（2026-10-14 用户的口径：结算以前没有名次）。
      这一期 21 套阵容、0 条积分，那一节渲染出来只有一句"还没有人交积分" —— 一个空壳
      标题占着首屏，看着像功能坏了。
      两个连带后果：① 进行中的名次现在只能在 /seasons/:id 看（那儿照旧列交了积分的人），
      routes/main.js 也就不再给这一条分支查 ranking 了（跟 eye 一样只有回退分支传）；
      ② 下面那句 "还没交积分（N）" 名单**留着** —— 它说的是交没交，不是名次。
      结算之后走下面「没有进行中的期」那个分支，排名表照旧出来（那时名次才定下来）。
      ⚠️ 要在这儿把排名表加回来，先去 routes/main.js 把 ranking 传回来。 %>

  <%# canRate / quota / rateLockAt 都是 routes/main.js 查好的：能打分 = 进行中且还没过截止点
      （每期开期后第一个周四 12:00）；quota 是**我自己**还剩的名额（封盘后是空的）；
      rateLockAt 给墙上显示截止时间。byScore 也在路由里查（db.isWallByScore）：
      封盘后墙改成按积分排，墙上那句顺序说明跟着换。 %>
  <%- include('partials/lineup-gallery', { rows: lineups, heading: '本期阵容', canRate, quota, rateLockAt, byScore }) %>

  <h3>还没交积分（<%= notSubmitted.length %>）</h3>
  <% if (!notSubmitted.length) { %>
    <p class="muted">所有人都交了，可以催管理员结算了。</p>
  <% } else { %>
    <ul class="plain-list">
      <% notSubmitted.forEach((p) => { %>
        <li>
          <a href="/u/<%= p.uid %>"><%= p.nickname %></a>
          <%- include('partials/eye', { uid: p.uid }) %>
          <% if (p.lineup_uploaded) { %>
            <span class="badge badge-ok">已传阵容</span>
          <% } else { %>
            <span class="badge badge-wait">还没传阵容</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
    <p><small class="muted">没交积分就拿不到名次（胜者是积分前两名），但传了阵容的<strong>仍算参赛</strong>、
      计入参赛次数和胜率。</small></p>
  <% } %>

<% } else { %>

  <hgroup class="page-head">
    <h2>本期看板</h2>
    <p class="muted">现在没有进行中的赛期，等管理员开启下一期</p>
  </hgroup>

  <% if (!last) { %>
    <p class="muted">还没有办过任何一期。管理员先去<a href="/admin">管理页</a>创建第一期吧。</p>
  <% } else { %>
    <h3><%= last.name %> 的结果 <span class="badge badge-settled">已结算</span></h3>
    <% if (myRank) { %>
      <p class="muted">你在这期拿了第 <strong class="num"><%= myRank %></strong> 名。</p>
    <% } %>
    <% if (!ranking.length) { %>
      <p class="muted">这一期没有人交积分。</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="w-rank">名次</th>
              <th>昵称</th>
              <th class="w-score">积分</th>
              <th class="w-time">提交时间</th>
              <th>积分截图</th>
              <th>阵容截图</th>
            </tr>
          </thead>
          <tbody>
            <% ranking.forEach((r, i) => { %>
              <tr class="<%= i < topN ? 'row-first' : '' %>">
                <td class="num"><%= i + 1 %></td>
                <td>
                  <a href="/u/<%= r.uid %>"><%= r.nickname %></a>
                  <%- include('partials/eye', { uid: r.uid }) %>
                  <%# 前两名都算胜者（db.js 的 TOP_N），两行都挂章、都高亮 %>
                  <% if (i < topN) { %><span class="badge badge-first">胜者</span><% } %>
                </td>
                <td class="num"><strong><%= r.score %></strong></td>
                <td><small class="muted"><%= fmt(r.score_submitted_at) %></small></td>
                <td>
                  <%# 截图 2026-10-17 起不是必填 —— 没有就画一个破折号，别让 thumbUrl(null) 拼出坏链接 %>
                  <% if (r.score_image) { %>
                    <a href="<%= imgUrl(r.score_image) %>" target="_blank" rel="noopener">
                      <img class="thumb" src="<%= thumbUrl(r.score_image) %>" alt="积分截图" loading="lazy">
                    </a>
                  <% } else { %>
                    <small class="muted">—</small>
                  <% } %>
                </td>
                <td>
                  <% if (r.images.length) { %>
                    <div class="thumb-row">
                      <%# data-shots 是这个人的全部阵容截图，给 public/lightbox.js 的弹层翻页用 %>
                      <% const shots = r.images.map((i) => imgUrl(i.filename)).join(' '); %>
                      <% r.images.forEach((img) => { %>
                        <a href="<%= imgUrl(img.filename) %>" target="_blank" rel="noopener" data-shots="<%= shots %>">
                          <img class="thumb" src="<%= thumbUrl(img.filename) %>" alt="阵容截图" loading="lazy">
                        </a>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <small class="muted">没传</small>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <%# 这一期已经结算了，打分也一起封盘：只显示均分/最高/最低，不出按钮。
        quota / rateLockAt 故意不传 —— 只出均分的那一版没有名额行，也没有截止时间可报，
        模板里用 locals.xxx 兜底（引一个没传进来的名字是 ReferenceError，整页会 500）。
        byScore 照传：已结算的期墙按积分排（db.isWallByScore），说明那句话也要跟着换。 %>
    <%- include('partials/lineup-gallery', { rows: lineups, heading: `${last.name} 阵容`, canRate: false, byScore }) %>

    <%- include('partials/eye-board', { rows: eye, heading: `${last.name} 慧眼等级变动` }) %>

    <p><a href="/seasons/<%= last.id %>">看这一期的完整详情</a> · <a href="/history">全部历史赛期</a></p>
  <% } %>

<% } %>

<%- include('partials/footer') %>
