<%- include('partials/header') %>

<hgroup class="page-head">
  <h2>
    <%= season.name %>
    <% if (settled) { %>
      <span class="badge badge-settled">已结算</span>
    <% } else { %>
      <span class="badge badge-open">进行中</span>
    <% } %>
  </h2>
  <p class="muted">
    开始于 <%= fmt(season.created_at) %>
    <% if (settled && season.settled_at) { %> · 结算于 <%= fmt(season.settled_at) %><% } %>
    <%# 两个数：参赛 = 上传了阵容就算（含只传阵容、没录分的人），交分 = 真有积分的。
        只报前者的话，下面那几张战绩卡看着像"只列了一小半人"。 %>
    · 参赛 <%= players %> 人 · 交分 <%= scored %> 人
    <%# 打分截止。只在进行中的期出现（已结算时 routes/main.js 传的 rateLockAt 是 null）；
        这一页没有打分区，所以能改的时候顺手指个路 —— 打分/改分都在首页阵容墙上 %>
    <% if (rateLockAt) { %>
      <% if (canRate) { %> · <a href="/">打分截止 <%= fmt(rateLockAt) %></a>（<%= fmtLeft(rateLockAt - Date.now()) %>）
      <% } else { %> · 打分已于 <%= fmt(rateLockAt) %> 截止<% } %>
    <% } %>
  </p>
</hgroup>

<% if (wallCount > 0) { %>
  <p>
    <a role="button" class="secondary" href="/seasons/<%= season.id %>/wall">看这一期阵容墙（<%= wallCount %> 套）</a>
  </p>
<% } %>

<%# 结算战报：一段能直接贴群里的纯文本，拼法在 routes/main.js 的 buildReport。
    **只有已结算的期才有**（进行中的期名次还会变，发出去的"冠军"过两天就成了假消息），
    其余时候 report 是 null，整段不出。
    **默认折叠**：它是"要用的时候才拿"的东西，摊开会把整页顶下去一大截；
    而真要用它的人（刚点完结算、被 302 送到这一页的管理员）一眼就能看见这个标题。 %>
<% if (report) { %>
  <details class="report">
    <summary>📋 复制战报（贴群里用）</summary>
    <div class="report-body">
      <p class="muted small">下面就是本期的成绩，全选复制就能贴到群里。</p>
      <%# 内容整个塞进只读文本框：它是拿来照抄的，落在 <p> 里会被当成正文读，
          还容易漏掉行尾。`rows` 按实际行数给，长战报进来就不用滚。
          EJS 的转义会把 & < > 变成实体，textarea 解析时再还原 —— 内容一字不差，
          顺手也堵死了"昵称里写个 </textarea>"这条路。
          ⚠️ 这类注释里**绝不能写出 EJS 的取值标记本身**：注释遇到它中间那个
          结束符号就当场截断，剩下半句会漏成页面上的正文（今天连踩两次）。 %>
      <textarea id="report-text" class="report-text" readonly
                rows="<%= report.split('\n').length %>"><%= report %></textarea>
      <%# 全选那一下在 public/report.js。没加载时文本框照样能长按选中，少的是个按钮 %>
      <div class="report-actions">
        <button type="button" class="secondary" id="report-select">全选这段</button>
        <small class="muted" id="report-hint">手机上长按文本框，再选「复制」</small>
      </div>
    </div>
  </details>
<% } %>

<%# 慧眼等级变动榜放在战绩卡**上面**：它是结算的头条结论（"这期谁涨得最多"），
    塞在十几张截图卡下面就得滚很久才看得到。 %>
<% if (settled) { %>
  <%- include('partials/eye-board', { rows: eye, heading: '本期慧眼等级变动' }) %>
  <%- include('partials/season-bests', { highlights, heading: `${season.name} · 本期之最` }) %>
<% } %>

<% if (!rows.length) { %>
  <p class="muted">这一期还没有人交积分。</p>
<% } else { %>
  <% rows.forEach((r, i) => { %>
    <%# 已结算：积分前 topN 名都算胜者（2026-10-15 起），这几张卡都描边、都挂👑。
        进行中：只有暂列第一那一位挂「暂列第一」—— 名次要结算才算数。 %>
    <article class="entry-card <%= i < topN && settled ? 'entry-winner' : '' %>">
      <header>
        <strong class="rank-no">#<%= i + 1 %></strong>
        <a href="/u/<%= r.uid %>"><%= r.nickname %></a>
        <%- include('partials/eye', { uid: r.uid }) %>
        <% if (i < topN && settled) { %><span class="badge badge-first">👑 胜者</span><% } %>
        <% if (i === 0 && !settled) { %><span class="badge badge-first">暂列第一</span><% } %>
        <span class="score-pill"><%= r.score %> 分</span>
        <small class="muted">提交于 <%= fmt(r.score_submitted_at) %></small>
      </header>

      <div class="entry-body">
        <div class="entry-shots">
          <%# 积分截图 2026-10-17 起不是必填 —— 没有这一张就整块不画（别留空 figure） %>
          <% if (r.score_image) { %>
            <figure>
              <a href="<%= imgUrl(r.score_image) %>" target="_blank" rel="noopener">
                <img src="<%= thumbUrl(r.score_image) %>" alt="<%= r.nickname %> 的积分截图" loading="lazy">
              </a>
              <figcaption>积分截图</figcaption>
            </figure>
          <% } %>
          <%# 这一个人的全部阵容截图，给 public/lightbox.js 的弹层翻页用（见 lineup-gallery.ejs） %>
          <% const shots = r.images.map((i) => imgUrl(i.filename)).join(' '); %>
          <% r.images.forEach((img) => { %>
            <figure>
              <a href="<%= imgUrl(img.filename) %>" target="_blank" rel="noopener" data-shots="<%= shots %>">
                <img src="<%= thumbUrl(img.filename) %>" alt="<%= r.nickname %> 的阵容截图" loading="lazy">
              </a>
              <figcaption>
                阵容截图
                <% if (!settled && (me.is_admin || r.user_id === me.id)) { %>
                  <form method="post" action="/lineup/<%= img.id %>/delete" class="inline-form">
                    <input type="hidden" name="back" value="season">
                    <button type="submit" class="outline secondary btn-sm">删除</button>
                  </form>
                <% } %>
              </figcaption>
            </figure>
          <% }) %>
        </div>

        <% if (r.lineup_note) { %>
          <p class="lineup-note"><strong>阵容说明：</strong><%= r.lineup_note %></p>
        <% } %>

        <% if (!settled && me.is_admin) { %>
          <form method="post" action="/admin/entries/<%= r.id %>" class="fix-form">
            <label>
              管理员修正积分
              <input type="number" name="score" min="0" max="999999999" step="1" value="<%= r.score %>" required>
            </label>
            <button type="submit" class="secondary btn-sm">修正</button>
            <small class="muted">修正不会刷新提交时间</small>
          </form>
        <% } %>
      </div>
    </article>
  <% }) %>
<% } %>

<% if (!settled && notSubmitted.length) { %>
  <h3>还没交积分（<%= notSubmitted.length %>）</h3>
  <ul class="plain-list">
    <% notSubmitted.forEach((p) => { %>
      <li>
        <a href="/u/<%= p.uid %>"><%= p.nickname %></a>
        <%- include('partials/eye', { uid: p.uid }) %>
        <% if (p.lineup_uploaded) { %>
          <span class="badge badge-ok">已传阵容</span>
        <% } else { %>
          <span class="badge badge-wait">还没传阵容</span>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<p><a href="/history">← 回到历史赛期</a></p>

<%- include('partials/footer') %>
