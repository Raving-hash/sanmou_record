<%- include('partials/header') %>

<hgroup class="page-head">
  <h2>历史赛期</h2>
  <p class="muted">一共办了 <%= rows.length %> 期</p>
</hgroup>

<% if (!rows.length) { %>
  <p class="muted">还没有任何一期。</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>期名</th>
          <th class="w-time">日期</th>
          <th class="w-status">状态</th>
          <th>胜者</th>
          <th class="w-score">胜者积分</th>
          <th class="w-players">参赛人数</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((s) => { %>
          <tr>
            <td><a href="/seasons/<%= s.id %>"><%= s.name %></a></td>
            <td><small class="muted"><%= fmt(s.created_at) %></small></td>
            <td>
              <% if (s.status === 'open') { %>
                <span class="badge badge-open">进行中</span>
              <% } else { %>
                <span class="badge badge-settled">已结算</span>
              <% } %>
            </td>
            <%# 胜者可能不止一个（每期积分前两名都算赢，见 db.js 的 TOP_N）。
                ！这里**不能**只印 s.winners[0]：那等于把第二名胜者藏起来，
                而 /seasons/:id 上他明明白白挂着👑。 %>
            <td>
              <% if (!s.winners.length) { %>
                <small class="muted">—</small>
              <% } else { %>
                <% s.winners.forEach((w, i) => { %><% if (i) { %>、<% } %><a href="/u/<%= w.uid %>">👑 <%= w.nickname %></a><%- include('partials/eye', { uid: w.uid }) %><% }) %>
              <% } %>
            </td>
            <%# 和上面那格一一对应：几个胜者就报几个分（用「/」隔开，别让人以为是总分） %>
            <td class="num"><%= s.winners.length ? s.winners.map((w) => w.score).join(' / ') : '—' %></td>
            <td class="num"><%= s.players %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
