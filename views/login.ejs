<%- include('partials/header') %>

<div class="auth-wrap">
  <hgroup>
    <h2>登录</h2>
    <p class="muted">《三国：谋定天下》演武积分赛战绩站</p>
  </hgroup>

  <% if (error) { %><div class="flash flash-err"><%= error %></div><% } %>

  <form method="post" action="/login">
    <label>用户 ID
      <input name="userId" value="<%= form.userId %>" required autofocus autocomplete="username"
             placeholder="小写字母、数字、下划线">
    </label>
    <label>密码
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="fit">登录</button>
  </form>

  <p><small class="muted">有邀请码？<a href="/register">去注册</a></small></p>
  <p><small class="muted">没有账号也能<a href="/wall">先逛逛阵容墙</a></small></p>
</div>

<%- include('partials/footer') %>
