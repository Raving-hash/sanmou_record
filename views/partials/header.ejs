<!doctype html>
<!-- data-theme="dark" 是墨金主题的前提：Pico 靠它切到暗色令牌分支。
     写死在这里（而不是跟随系统）是为了所有人看到的都是同一套配色。
     style.css 里的 --pico-primary-inverse 等假设也建立在暗色分支上。
     data-img-base 是给 public/lightbox.js 判"这个链接是不是图"用的前缀：
     图片自 2026-10-15 起在 Cloudflare R2 的公开域名上（.env 的 R2_PUBLIC_BASE_URL），
     href 成了跨域的绝对地址，JS 里没法再靠相对路径判断。域名只从服务端来，
     静态 JS 里一个字都不硬编码。 -->
<html lang="zh-CN" data-theme="dark" data-img-base="<%= imgBase %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#1d1913">
  <title><%= locals.title ? title + ' · 演武擂台' : '演武擂台' %></title>
  <%# ?v= 是给 nginx 的 expires 7d 破缓存用的：/public/ 反代给 Node 时
      nginx 会盖上 max-age=604800，改了 style.css 浏览器最多一周都不来取新的。
      带上文件 mtime 后每次改动都是新 URL，不用让用户按 Ctrl+Shift+R。 %>
  <link rel="stylesheet" href="/public/pico.min.css?v=<%= assetVer.pico %>">
  <link rel="stylesheet" href="/public/style.css?v=<%= assetVer.style %>">
  <%# 站点图标（2026-10-16 加）。三份都在 public/ 下，由 scripts/make-icon.js 生成：
      icon.svg 是取字形轮廓画的矢量版，favicon.ico 里装 16/32/48 三档，
      apple-touch-icon.png 给 iOS 加到桌面用。**ICO 在前、SVG 在后**：
      认 SVG 的浏览器（Chrome/Firefox/Safari 16.4+）会挑后面那份矢量图，
      不认的（老 Safari、老 IE）就用前面那个 ICO —— 两边都照顾到。
      ?v= 的理由和那两个 CSS 一样（nginx 给 /public/ 盖了 7 天缓存）。 %>
  <link rel="icon" href="/public/favicon.ico?v=<%= assetVer.ico %>" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/svg+xml" href="/public/icon.svg?v=<%= assetVer.icon %>">
  <link rel="apple-touch-icon" href="/public/apple-touch-icon.png?v=<%= assetVer.touch %>">
</head>
<body>
<nav class="container-fluid topnav">
  <ul>
    <%# 品牌左边那方金印就是页签上那个图标本身（public/icon.svg，同一份文件、同一个 ?v=）。
        alt="" 是故意的：旁边的「演武擂台」已经把话说完了，读屏再念一遍是噪音。
        ⚠️ 别再给它配一条 <link rel="icon"> —— head 里那三行是被逐条数过的
        （mkicon.js 期望正好 3 条，多一条整套 icon 断言直接抛错）。 %>
    <li><a class="brand" href="/"><img class="brand-seal" src="/public/icon.svg?v=<%= assetVer.icon %>" alt="" width="30" height="30">演武擂台</a></li>
  </ul>
  <ul>
    <% if (locals.me) { %>
      <li><a href="/" class="<%= path === '/' ? 'active' : '' %>">本期</a></li>
      <li><a href="/history" class="<%= path === '/history' ? 'active' : '' %>">历史</a></li>
      <li><a href="/rank" class="<%= path === '/rank' ? 'active' : '' %>">排行</a></li>
      <li><a href="/ratings" class="<%= path === '/ratings' ? 'active' : '' %>">打分</a></li>
      <li><a href="/u/<%= me.user_id %>" class="<%= path.startsWith('/u/') ? 'active' : '' %>">我的</a></li>
      <% if (me.is_admin) { %>
        <li><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">管理</a></li>
      <% } %>
      <li><a href="/password" class="<%= path === '/password' ? 'active' : '' %>">改密码</a></li>
      <li>
        <form method="post" action="/logout" class="nav-out">
          <button type="submit" class="outline secondary btn-sm">退出</button>
        </form>
      </li>
    <% } else { %>
      <li><a href="/wall" class="<%= path === '/wall' ? 'active' : '' %>">阵容墙</a></li>
      <li><a href="/login" class="<%= path === '/login' ? 'active' : '' %>">登录</a></li>
      <li><a href="/register" class="<%= path === '/register' ? 'active' : '' %>">注册</a></li>
    <% } %>
  </ul>
</nav>
<main class="container">
<% if (locals.flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.msg %></div>
<% } %>
