<%- include('partials/header') %>

<div class="auth-wrap">
  <hgroup>
    <h2>注册</h2>
    <p class="muted">填上管理员给的邀请码就能加入</p>
  </hgroup>

  <p class="muted small">第一次来？<a href="/rules">先看赛制说明</a>。</p>

  <% if (error) { %><div class="flash flash-err"><%= error %></div><% } %>

  <form method="post" action="/register">
    <label>邀请码
      <input name="code" value="<%= form.code %>" required autocapitalize="characters"
             placeholder="例如 7KQP3XMR">
    </label>
    <label>用户 ID
      <input name="userId" value="<%= form.userId %>" required autocomplete="username"
             placeholder="小写字母、数字、下划线">
      <small class="muted">3–20 位。注册后不能修改，大写会自动转成小写</small>
    </label>
    <label>昵称
      <input name="nickname" value="<%= form.nickname %>" required placeholder="1–12 个字">
    </label>
    <label>密码
      <input type="password" name="password" required autocomplete="new-password" placeholder="至少 6 位">
    </label>
    <label>确认密码
      <input type="password" name="password2" required autocomplete="new-password">
    </label>
    <button type="submit" class="fit">注册并登录</button>
  </form>

  <p><small class="muted">已经有账号？<a href="/login">去登录</a></small></p>
</div>

<%- include('partials/footer') %>
